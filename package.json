{
  "name": "vila-do-noel-live",
  "version": "1.0.0",
  "private": true,
  "description": "Jogo interativo natalino para lives verticais (9:16) - MVP 1.0",
  "type": "module",
  "scripts": {
    "start": "vite build && tsx server/index.ts",
    "servidor": "tsx server/index.ts",
    "dev": "concurrently -k -n servidor,vite -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "demo": "vite build --mode demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lab": "vite -c lab/vite.config.ts",
    "sala": "vite build --mode sala",
    "pacote:backend": "node deploy/empacotar-backend.mjs",
    "pacote:frontend": "node deploy/empacotar-frontend.mjs",
    "pacotes": "node deploy/empacotar-backend.mjs && node deploy/empacotar-frontend.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "phaser": "3.90.0",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "vite": "6.4.6",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "concurrently": "9.2.5",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
